# Copy this file to .env and adjust as needed

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/yt-downloader
DOWNLOAD_DIR=./downloads

# Comma-separated origins allowed to call this API (your local frontend)
CORS_ORIGIN=http://localhost:5173

# Path/command for the yt-dlp binary. Leave as "yt-dlp" if it's on your PATH
# (recommended — see README prerequisites). Only change this if you installed
# yt-dlp somewhere npm/Node can't find it, e.g. a full path on Windows like
# C:\\tools\\yt-dlp.exe
YTDLP_PATH=yt-dlp

# If downloads fail with "Sign in to confirm you're not a bot", uncomment ONE
# of these (see README troubleshooting). COOKIES_FROM_BROWSER is easiest —
# use the browser you're actually signed into YouTube with: chrome, edge,
# firefox, brave, etc. Fully close that browser first so yt-dlp can read its
# cookie database.
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=./cookies.txt
